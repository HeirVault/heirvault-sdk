{
  "name": "heirvault-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript SDK for the HeirVault Soroban inheritance contracts on Stellar.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "inheritance",
    "will",
    "blockchain",
    "wallet"
  ],
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0"
  },
  "peerDependencies": {
    "@stellar/freighter-api": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/freighter-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stellar/freighter-api": "^4.0.0",
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
