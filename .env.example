# ─────────────────────────────────────────────────────────────────────────────
# HeirVault SDK — environment configuration
#
# Copy to `.env` for local runs and fill in real values. Every value is a
# *public* identifier except the one explicitly marked as a Testnet-only
# secret. NEVER commit `.env`, secret keys or recovery phrases.
#
# The SDK itself does not read `process.env` — it takes configuration through
# `HeirVaultClient` constructor options. These variables exist so the opt-in
# integration tests (`npm run test:integration`) and example scripts can be run
# without hard-coding deployment values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
# One of: testnet | mainnet | futurenet | standalone
HEIRVAULT_NETWORK=testnet
# Soroban RPC endpoint (defaults to the canonical endpoint for the network).
HEIRVAULT_RPC_URL=https://soroban-testnet.stellar.org
# Horizon endpoint (account/balance reads).
HEIRVAULT_HORIZON_URL=https://horizon-testnet.stellar.org
# Network passphrase (defaults to the canonical passphrase for the network).
HEIRVAULT_NETWORK_PASSPHRASE=

# ── Contract + asset ─────────────────────────────────────────────────────────
# Deployed HeirVault contract id (C...).
# Leave blank until you have a real deployment — never invent a contract id.
HEIRVAULT_CONTRACT_ID=

# SEP-41 token contract the vault distributes (C...).
HEIRVAULT_ASSET_CONTRACT_ID=
HEIRVAULT_ASSET_SYMBOL=USDC
HEIRVAULT_ASSET_DECIMALS=7

# ── Testnet integration tests (npm run test:integration) ─────────────────────
# A funded Testnet account (G...) used as the read source and write owner.
HEIRVAULT_TESTNET_CONTRACT_ID=
HEIRVAULT_TESTNET_ACCOUNT=
# The SEP-41 asset used when the write path is exercised.
HEIRVAULT_TESTNET_ASSET=

# TESTNET ONLY. Enables the write path of the integration suite. This is the
# only secret in this file; it belongs to a throwaway Testnet key and must never
# be used for real funds or committed.
HEIRVAULT_TESTNET_SECRET=
